<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>occlusion_handler</name>
  <version>0.1.0</version>
  <description>
    Real-time object detection (YOLOv8) fused with depth, with an
    occlusion-aware position estimation mode: when tracked objects overlap
    in the image, excludes pixels contaminated by a nearer object before
    estimating the target's depth, and samples up to 3 points on the
    target's visible surface for downstream grasp-circle fitting.
  </description>
  <maintainer email="pieromutasci@gmail.com">pieromutasci</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tiago_vision_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
