<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pose_optimizer</name>
  <version>0.1.0</version>
  <description>
    Inverse-kinematics pose optimization for grasping: sends target poses to
    MoveIt (move_group) using the PickIK plugin, with the TIAGo Pro MoveIt
    config, kinematics settings and RViz visualisation used for this task.
  </description>
  <maintainer email="pieromutasci@gmail.com">pieromutasci</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- joint_margin_optimizer: legge la posa reale dell'end effector via TF -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tiago_pro_moveit_config</exec_depend>
  <exec_depend>pick_ik</exec_depend>
  <!-- manipulability_optimizer: Jacobiano via KDL, catena costruita a mano
       dall'URDF vero (kdl_parser_py non esiste per Humble: solo la
       libreria C++, ros-humble-kdl-parser, senza binding Python) -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python_orocos_kdl_vendor</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
