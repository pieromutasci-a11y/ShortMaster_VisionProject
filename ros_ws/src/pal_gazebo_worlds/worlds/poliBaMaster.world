      <uri>model://table_0m8</uri>
      <name>s3_table</name>
      <pose>5.0 5.0 0.0  0 0 0</pose>
    </include>

    <include>
      <uri>model://aruco_marker_original_63</uri>
      <name>s3_aruco</name>
      <pose>4.5 4.60 0.80  1.5708 0 0</pose>
      <static>1</static>
    </include>


    <include>
      <uri>model://cocacola</uri>
      <name>s3_cocacola</name>
      <!-- Spostata "indietro" (Y maggiore, piu' lontana dalla camera che
           guarda verso +Y dalla posa di spawn del robot, 5.0 3.5) rispetto
           alla posizione originale (5.0 4.65), per lasciare spazio ai
           biscotti davanti a lei: test occlusion handling, vedi s3_biscuits. -->
      <pose>5.0 4.80 0.815  0 0 0</pose>
    </include>


    <include>
      <uri>model://pringles</uri>
      <name>s3_pringles</name>
      <pose>5.25 5.05 0.815  0 0 0.4</pose>
    </include>

    <include>
      <uri>model://biscuits_pack</uri>
      <name>s3_biscuits</name>
      <!-- Spostati davanti alla coca (Y minore = piu' vicini alla camera)
           e leggermente sfalsati in X, cosi' da coprirne il ~60% della
           larghezza apparente vista dalla camera (raggio coca 0.04m,
           raggio biscotti 0.029m: anche i biscotti sono un cilindro in
           questo modello, non una scatola). Test occlusion handling per
           detection_and_ranging_occlusion_handler. -->
      <pose>5.02 4.65 0.815  0 0 0</pose>
    </include>

    <include>
      <uri>model://reemc_bookshelf</uri>
      <name>s3_bookshelf</name>
      <pose>6.5 4.0 0.0  0 0 -1.5708</pose>
    </include>

